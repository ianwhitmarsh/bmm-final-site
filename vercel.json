{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/works/918-family-wellness",
      "destination": "/works",
      "permanent": true
    },
    {
      "source": "/works/lee-signature-homes-:rest*",
      "destination": "/works",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
